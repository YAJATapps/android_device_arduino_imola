import /vendor/etc/init/init.imola.usb.rc

on early-fs
    start vold

on fs
    mount_all /vendor/etc/fstab.imola --early
    swapon_all /vendor/etc/fstab.imola

on post-fs
    setrlimit 8 67108864 67108864

on late-fs
    mount_all /vendor/etc/fstab.imola --late

on init
    # Symlink by-name partitions for bootdevice lookup
    mkdir /dev/block/bootdevice 0775 root system
    symlink /dev/block/by-name /dev/block/bootdevice/by-name

    # ZRAM setup
    write /sys/block/zram0/comp_algorithm lz4
    # Initialize cpusets for 4-core Cortex-A53 (CPUs 0-3)
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/top-app/cpus 0-3

on early-boot
    mount debugfs debugfs /sys/kernel/debug
    chmod 755 /sys/kernel/debug
    chmod 755 /sys/kernel/debug/sync
    chown graphics graphics /sys/kernel/debug/sync/sw_sync
    chmod 777 /sys/kernel/debug/sync/sw_sync
    chown graphics graphics /sys/kernel/debug/sync/info

on boot
    start console

on zygote-start
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi

on property:sys.boot_completed=1
    chmod 0755 /sys/kernel/debug/tracing

    # Update cpuset now that boot completed (4-core QRB2210)
    write /dev/cpuset/foreground/cpus 0-2
    write /dev/cpuset/top-app/cpus 0-3
    write /dev/cpuset/background/cpus 0
    write /dev/cpuset/system-background/cpus 0-1

    trigger sys-boot-completed-set

on sys-boot-completed-set && property:persist.sys.zram_enabled=1
    swapon_all

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
                       -O/data/vendor/wifi/wpa/sockets \
                       -Dnl80211 -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    socket wpa_wlan0 dgram 660 wifi wifi
    group wifi net_raw net_admin
    user root
    disabled
    oneshot

service suspend_blocker /vendor/bin/suspend_blocker
    class early_hal
    group system
    user root

service logcat_console /system/bin/logcat -b crash,system,main -v brief *:I
    class main
    user root
    group log root system
    console

# Modem firmware & remote storage services
on post-fs-data
    mkdir /data/vendor 0771 root system
    mkdir /data/vendor/tmp 0771 root system
    mkdir /data/vendor/readwrite 0771 root system
    mkdir /data/vendor/readonly 0771 root system
    mkdir /data/vendor/readonly/firmware 0771 root system
    mkdir /data/vendor/readonly/firmware/image 0771 root system
    write /sys/class/firmware/timeout 1
    exec - root -- /vendor/bin/qrtr-cfg 1
    start vendor.tqftpserv
    start vendor.rmtfs

on shutdown
    stop vendor.rmtfs

service vendor.tqftpserv /vendor/bin/tqftpserv
    class core
    user root
    group system
    stdio_to_kmsg
    disabled

service vendor.rmtfs /vendor/bin/rmtfs -o /dev/block/by-name -P -r -s
    class core
    user root
    group system
    stdio_to_kmsg
    disabled

